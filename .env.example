# Copy to .env (gitignored) and fill in. docker compose reads it automatically.
DATABASE_USER=insta
DATABASE_PASSWORD=change-me
# At least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Comma-separated OAuth client IDs accepted as the Google ID token audience
# (the Web client ID used as serverClientId in the app). Empty = Google sign-in disabled.
GOOGLE_CLIENT_IDS=
# Local demos only: also return one-time sign-in codes in the API response (they're always written to the server log).
# Never enable on a server other people can reach: anyone could then sign in as any number.
OTP_DEV_ECHO=true
# Firebase service-account key for FCM push, as seen inside the container. Put the file in ./secrets/ (gitignored),
# e.g. FIREBASE_CREDENTIALS_FILE=/run/secrets/insta/firebase-adminsdk.json. Empty = push disabled (in-app only).
FIREBASE_CREDENTIALS_FILE=
